# Disabling EnumCastOutOfRange due to how Filament uses Enums as bitmasks (see utils/BitmaskEnum.h)
# Disabling NewDeleteLeaks due to many false positives
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -clang-diagnostic-ignored-gch,
  readability-identifier-naming
WarningsAsErrors: ''
HeaderFileExtensions:
  - ''
  - h
  - hh
  - hpp
  - hxx
ImplementationFileExtensions:
  - c
  - cc
  - cpp
  - cxx
HeaderFilterRegex: '^((?!third_party/).)*$'
CheckOptions:
  - key: readability-identifier-naming.PrivateMemberCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: m
  - key: readability-identifier-naming.ProtectedMemberCase
    value: camelBack
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: m
FormatStyle:     file
SystemHeaders:   false
